# 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요 (cp .env.example .env).
# 로컬 개발은 .env 하나면 충분합니다(gitignore됨).
# 프로덕션 값은 Vercel 대시보드의 Environment Variables로 주입됩니다.

# --- Supabase (공개 값, 클라이언트에 노출됨) ---
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Resend (비밀 값, 서버 전용 — 뉴스레터 구독 처리) ---
RESEND_API_KEY=re_your_api_key
RESEND_AUDIENCE_ID=your-audience-id
