{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "paths": {
      "@/*": ["./src/*"],
      "@mdx/*": ["./mdx/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
