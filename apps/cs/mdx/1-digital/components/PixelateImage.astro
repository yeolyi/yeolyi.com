---
import Slider from "@yeolyi/ui/Slider";
import { Loader2 } from "lucide-react";
import changdeokgung from "../assets/changdeokgung.jpg";
---

<form id="pixelate-form" class="demo">
  <div class="flex flex-col gap-[0.5rlh] py-[0.5rlh]">
    {
      /* 결과 — 픽셀화된 이미지. 캔버스가 항상 2:1 이라 컨테이너도 2:1 로 맞춰
        찌그러짐 없이 표시한다. */
    }
    <div class="relative aspect-[2/1] w-full">
      <img
        id="pixelated"
        alt="픽셀화된 이미지"
        class="h-full w-full"
        style="image-rendering: pixelated;"
      />

      <div
        id="loading"
        class="absolute inset-0 flex items-center justify-center"
      >
        <span class="bg-background/80 text-foreground p-2">
          <Loader2 className="size-8 animate-spin" />
        </span>
      </div>
    </div>

    {
      /* 조작 — 라벨·수치를 슬라이더에 바로 붙여(좁은 갭) 한 덩어리로 읽히게 한다. */
    }
    <div class="flex flex-col gap-1.5">
      <span class="text-muted-foreground">
        해상도{" "}
        <span id="resolution" class="text-foreground font-mono">64×32</span>
      </span>
      <Slider
        name="pixelPow"
        defaultValue={5}
        min={1}
        max={10}
        step={1}
        client:idle
      />
    </div>
  </div>

  <img id="source" src={changdeokgung.src} alt="원본" class="hidden" />
</form>

<script>
  const form = document.querySelector<HTMLFormElement>("#pixelate-form")!;
  const sourceImg = document.querySelector<HTMLImageElement>("#source")!;
  const pixelatedImg = document.querySelector<HTMLImageElement>("#pixelated")!;
  const resolutionSpan = document.querySelector("#resolution")!;
  const loading = document.querySelector<HTMLDivElement>("#loading")!;

  const worker = new Worker("/pixelateWorker.js");

  let currentBlobUrl: string | null = null;
  let isImageSentToWorker = false;

  worker.onmessage = (e) => {
    const { blob } = e.data;

    if (currentBlobUrl) {
      URL.revokeObjectURL(currentBlobUrl);
    }

    currentBlobUrl = URL.createObjectURL(blob);
    pixelatedImg.src = currentBlobUrl;

    loading.classList.add("hidden");
  };

  async function processImage() {
    const formData = new FormData(form);
    const pixelPow = parseInt(formData.get("pixelPow") as string) || 5;
    const pixelCnt = 2 ** pixelPow;

    loading.classList.remove("hidden");
    resolutionSpan.textContent = `${pixelCnt * 2}×${pixelCnt}`;

    // 처음에만 ImageBitmap을 Worker로 전송, 이후에는 크기만 전송
    if (!isImageSentToWorker) {
      const imageBitmap = await createImageBitmap(sourceImg);
      worker.postMessage(
        { imageBitmap, width: pixelCnt * 2, height: pixelCnt },
        [imageBitmap],
      );
      isImageSentToWorker = true;
    } else {
      worker.postMessage({ width: pixelCnt * 2, height: pixelCnt });
    }
  }

  if (sourceImg.complete) {
    processImage();
  } else {
    sourceImg.addEventListener("load", processImage);
  }

  form.addEventListener("input", processImage);
</script>
