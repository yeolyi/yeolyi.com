---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import { LoginButton, LogoutButton } from "@/components/private/AuthButtons";
import Training from "@/components/private/Training";

interface Props {
  isAuthed: boolean;
  isOwner: boolean;
  githubId: string | null;
}
const { isAuthed, isOwner, githubId } = Astro.props;
---

<BaseLayout title="비공개" noindex opengraph={false}>
  <div
    class="measure-col mt-[2rlh] pb-[5rlh] [&_.md-table_td]:border-0 [&_.md-table_th]:border-0"
  >
    {
      !isAuthed ? (
        <LoginButton client:load />
      ) : !isOwner ? (
        <>
          <h1>접근 권한 없음</h1>
          <p>이 계정({githubId ?? "알 수 없음"})은 접근 권한이 없습니다.</p>
          <LogoutButton client:load />
        </>
      ) : (
        <Training client:load />
      )
    }
  </div>
</BaseLayout>
