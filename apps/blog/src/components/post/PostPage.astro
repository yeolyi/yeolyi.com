---
import { type CollectionEntry, render } from "astro:content";
import HeartButton from "@yeolyi/post/HeartButton";
import { mdxComponents } from "@yeolyi/post/mdx";
import PostMeta from "@yeolyi/post/PostMeta";
import BaseLayout from "@/components/layout/BaseLayout.astro";
import { formatDate, getVisiblePosts, postSlug } from "@/lib/content";

interface Props {
  page: CollectionEntry<"post">;
}

const { page } = Astro.props;
const slug = postSlug(page.id);
const { Content } = await render(page);

const meta = formatDate(page.data.date);

// 이전·다음 글은 날짜순(이전 = 더 오래된 글). 숨김 글은 건너뛰고, 숨김 글 자신에게는 잇지 않는다.
const order = (await getVisiblePosts()).toReversed();
const index = order.findIndex((p) => p.id === page.id);
const prev = index > 0 ? order[index - 1] : undefined;
const next = index >= 0 ? order[index + 1] : undefined;
const href = (p: CollectionEntry<"post">) => `/post/${postSlug(p.id)}`;
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  ogType="article"
>
  {
    /* 사이트 헤더(Masthead)는 모든 페이지 공통으로 BaseLayout 이 렌더한다. 글은 그
     아래 한 칸(mt-1lh) 띄워 문서 헤더(제목·메타·추천)부터 시작한다. 디바이더, 본문,
     아래=추천 순. 상·하단 추천은 스토어로 동기화. 간격은 DS 리듬(1lh·2lh). */
  }
  <div class="measure-col mt-[2lh] pb-[5lh] [&_astro-island]:block">
    {
      /* 글 머리: 제목, 0.5줄 아래 날짜·조회(왼쪽)와 추천(오른쪽 끝) 한 줄, 1px 가는 선으로 본문과 나눈다.
       추천 아이콘의 안쪽 여백은 -mr-2 로 상쇄해 오른쪽 선을 맞춘다. */
    }
    <header class="border-border border-b pb-[0.5lh]">
      <h1>{page.data.title}</h1>
      <div class="mt-[0.25lh] flex items-center justify-between gap-4">
        <PostMeta date={meta} site="blog" client:idle />
        {
          /* 추천은 누를 자리(44px)는 지키되 줄 높이엔 끼어들지 않게 위아래를 겹쳐 둔다. */
        }
        <div class="-my-2 -mr-2">
          <HeartButton postId={slug} client:idle />
        </div>
      </div>
    </header>

    <div class="prose mt-[1.5lh]">
      <Content components={mdxComponents} />
    </div>

    {
      /* 글 끝: 가는 선 아래 왼쪽 정렬로 세로로 쌓는다. 추천(머리의 것과 동기화), 그 아래 이전 글·다음 글.
         이전·다음은 표시와 제목을 한 줄에 두고, 표시 칸 폭을 맞춰 제목의 시작선을 가지런히 한다.
         추천 아이콘의 안쪽 여백은 -ml-2 로 상쇄해 왼쪽 선을 맞춘다. */
    }
    <footer class="border-border mt-[2lh] border-t pt-[0.5lh]">
      <div class="-my-2 -ml-2 w-fit">
        <HeartButton postId={slug} client:idle />
      </div>
      {
        (prev || next) && (
          <nav
            aria-label="이전·다음 글"
            class="mt-[0.5lh] grid grid-cols-[auto_1fr] items-baseline gap-x-4"
          >
            {prev && (
              <>
                <span class="text-muted-foreground">이전 글</span>
                <a class="w-fit" href={href(prev)} rel="prev">
                  {prev.data.title}
                </a>
              </>
            )}
            {next && (
              <>
                <span class="text-muted-foreground">다음 글</span>
                <a class="w-fit" href={href(next)} rel="next">
                  {next.data.title}
                </a>
              </>
            )}
          </nav>
        )
      }
    </footer>
  </div>
</BaseLayout>
