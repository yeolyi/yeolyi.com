---
import { getCollection } from "astro:content";
import { readFileSync } from "node:fs";
import { Details, Summary } from "@yeolyi/ui/Details";
import ClaudeCode from "../components/ClaudeCode";
import CopyButton from "../components/CopyButton";
import Page from "../layouts/Page.astro";

export async function getStaticPaths() {
  const prompts = await getCollection("prompts");
  return prompts.map((p) => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props;
// 틀이 있으면 프롬프트 끝에 붙인다. 틀은 public/ 의 파일 하나가 정본이라 md 에 베껴 두지 않는다
const template = p.data.template
  ? readFileSync(`public${p.data.template}`, "utf8").trim()
  : null;
const text = [
  (p.body ?? "").trim(),
  template && `\`\`\`html\n${template}\n\`\`\``,
]
  .filter(Boolean)
  .join("\n\n");
const date = p.data.date.toISOString().slice(0, 10);
---

<Page title={p.data.title} description={p.data.description}>
  <header class="border-border border-b pb-[0.5rlh]">
    <p class="text-muted-foreground font-mono text-base">
      <a href="/" class="text-muted-foreground">AI</a> · {date}
    </p>
    <h1>{p.data.title}</h1>
    <p class="text-muted-foreground mt-[0.25rlh]">{p.data.description}</p>
  </header>
  <!-- 복사가 이 페이지의 할 일이라 맨 위에. 무엇이 나오는지는 아래 실제 결과(대화나 그림)로 본다. -->
  <div class="mt-[1.5rlh]">
    <CopyButton client:load text={text} />
  </div>
  {
    p.data.examples.length > 0 && (
      <ClaudeCode turns={p.data.examples} className="mt-[1.5rlh]" />
    )
  }
  {
    p.data.images.map((img) => (
      <img
        src={img.src}
        alt={img.alt}
        loading="lazy"
        class="border-border mt-[1.5rlh] w-full border"
      />
    ))
  }
  <!-- 원문은 길어서 접어 둔다. 복사는 위 버튼으로. -->
  <Details className="mt-[1rlh]">
    <Summary>프롬프트 보기</Summary>
    <pre class="font-mono text-base whitespace-pre-wrap">{text}</pre>
  </Details>
</Page>
