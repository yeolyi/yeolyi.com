{
  "name": "carousel",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "export": "node scripts/export.ts",
    "typecheck": "tsc --noEmit",
    "import-key": "uv run --quiet --with keynote-parser --with pillow --with pyyaml python scripts/import_keynote.py",
    "pull": "node scripts/sync.ts pull",
    "push": "node scripts/sync.ts push",
    "build": "vite build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@yeolyi/track": "workspace:*",
    "@yeolyi/ui": "workspace:*",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.52.0",
    "modern-screenshot": "^4.7.0",
    "pretendard": "^1.3.9",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^26.6.4",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
