{
  "$schema": "https://biomejs.dev/schemas/2.3.13/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    // public 은 그대로 배포되는 정적 파일이라 소스가 아니다
    "includes": [
      "**",
      "!!**/dist",
      "!!**/.vercel",
      "!!**/.astro",
      "!!**/public"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  // https://biomejs.dev/internals/language-support/#html-super-languages-support
  // When linting .svelte, .astro or .vue files,
  // it’s advised to turn off a few additional rules
  // to prevent false positive linting errors
  // caused by our partial support.
  "overrides": [
    {
      // 테스트는 결과를 풀어 바로 단언하니 `!` 가 틀려도 테스트가 터진다
      "includes": ["**/tests/**", "**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "style": {
            "useConst": "off",
            "useImportType": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    }
  ]
}
